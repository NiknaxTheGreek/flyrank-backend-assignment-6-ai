# Deterministic mode is the safe default for local tests and the browser demo.
LLM_ENABLED=true
LLM_MODE=stub
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.15
LLM_CACHE_TTL_SECONDS=300
LLM_QUARANTINE_PATH=runtime/quarantine/invalid-provider-output.jsonl

# Optional cost-estimation inputs. Set these to the provider/model prices you
# are actually using; zero means "not configured", never an invented price.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

# To use OpenAI Responses API, set LLM_MODE=openai and inject this as a secret.
# OPENAI_API_KEY=
# Replit AI Integrations injects AI_INTEGRATIONS_OPENAI_BASE_URL and
# AI_INTEGRATIONS_OPENAI_API_KEY automatically; do not add their values here.
OPENAI_MODEL=gpt-4.1-mini
